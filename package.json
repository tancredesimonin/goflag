{
  "name": "@goflag/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "goflag — a CLI that flags the site problems humans can't catch at scale, and the tooling around it.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0 && pnpm -r --if-present lint",
    "lint:fix": "eslint . --fix",
    "dev:website": "pnpm --filter @goflag/website dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter @goflag/cli dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1"
  }
}
