# Secrets — never commit
.env
.env.local
.env.*.local

# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
build/

# Generated by content-collections on every dev/build, and by Next on first run.
# Both are derived from files that are committed, so committing them only creates
# a second source of truth that goes stale.
.content-collections/
next-env.d.ts

# Test coverage / artifacts
coverage/
test-results/
playwright-report/
playwright/.cache/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Staged into the package at pack time by scripts/stage-package-docs.mjs.
# The root copies are the real ones; these are never authored by hand.
/packages/cli/README.md
/packages/cli/LICENSE

# Goflag
.goflag/
tsconfig.tsbuildinfo

# Goflag audit report outputs (generated by --report / --json > file)
goflag.json
*.goflag.json
