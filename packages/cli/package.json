{
  "name": "goflag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A lean CLI that audits a site for broken links, missing translation pages, and missing/misconfigured SEO metadata. JSON-first.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "goflag": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src test/unit",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "optionalDependencies": {
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "commit-and-tag-version": "^12.5.0",
    "hono": "^4.12.25",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
