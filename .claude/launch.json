{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:website"
      ],
      "port": 3004
    },
    {
      "name": "website-standalone",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "APP_ENV=production",
        "PORT=3004",
        "NEXT_PUBLIC_WEBSITE_FRONTEND_URL=http://localhost:3004",
        "pnpm",
        "--filter",
        "@goflag/website",
        "serve:standalone"
      ],
      "port": 3004
    }
  ]
}
